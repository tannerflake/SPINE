{
  "firestore": [
    {
      "database": "wellread",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ]
  },
  "extensions": {
    "firestore-bigquery-export": "firebase/firestore-bigquery-export@^0.3.3",
    "firestore-bigquery-export-userbooks": "firebase/firestore-bigquery-export@^0.3.3"
  }
}
