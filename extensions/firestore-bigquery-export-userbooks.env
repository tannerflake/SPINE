# Stream Firestore to BigQuery: mirrors the `userBooks` collection (wellread DB)
# so we can chart books ranked per day from the exact moment `tier` goes from
# empty to set (old_data is kept so the transition is visible).
DATASET_LOCATION=us
DATABASE=wellread
DATABASE_REGION=nam5
COLLECTION_PATH=userBooks
WILDCARD_IDS=false
DATASET_ID=wellread_analytics
TABLE_ID=userBooks
TABLE_PARTITIONING=NONE
MAX_DISPATCHES_PER_SECOND=100
VIEW_TYPE=view
USE_NEW_SNAPSHOT_QUERY_SYNTAX=no
EXCLUDE_OLD_DATA=no
MAX_ENQUEUE_ATTEMPTS=3
LOG_LEVEL=info
